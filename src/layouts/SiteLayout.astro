---
import '../styles/global.css';

interface Props {
  title: string;
  heading: string;
  description: string;
  subtitle?: string;
  heroImage?: string;
  heroImageMobile?: string;
  shareImage?: string;
  shareImageAlt?: string;
}
const {
  title,
  heading,
  description,
  subtitle,
  heroImage = '/image.jpg',
  heroImageMobile,
  shareImage = '/share-image.jpg',
  shareImageAlt = 'Jitsu Wales Japanese Jiu Jitsu training',
} = Astro.props;
const pathname = Astro.url.pathname;
const canonicalURL = new URL(`${pathname.replace(/\/+$/, '')}/`, Astro.site);
const shareImageURL = new URL(shareImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jitsu Wales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImageURL} />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageURL} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <nav class="navigation" aria-label="Main navigation">
        <a class="brand" href="/">Jitsu Wales</a>
        <div class="nav-links">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/#clubs">Find a club</a>
          <a href="/events/" aria-current={pathname === '/events/' ? 'page' : undefined}>Events</a>
        </div>
      </nav>
    </header>
    <main id="main-content">
      <section
        class="hero"
        style={{
          '--hero-image': `url("${heroImage}")`,
          '--hero-image-mobile': heroImageMobile ? `url("${heroImageMobile}")` : undefined,
        }}
        aria-labelledby="page-heading"
      >
        <div class="hero-content">
          <h1 id="page-heading">{heading}</h1>
          {subtitle && <p>{subtitle}</p>}
        </div>
      </section>
      <div class="container"><slot /></div>
    </main>
    <footer>
      <p>Jitsu Wales · Japanese Jiu Jitsu</p>
      <a href="https://www.jitsufoundation.org">The Jiu Jitsu Foundation</a>
    </footer>
  </body>
</html>
