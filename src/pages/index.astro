---
import SiteLayout from '../layouts/SiteLayout.astro';
import { clubs } from '../data/clubs';
---

<SiteLayout
  title="Jitsu Wales | Japanese Jiu Jitsu"
  heading="Jitsu Wales"
  subtitle="Japanese Jiu Jitsu in Wales"
  heroImage="/jitsu-wales-banner.png"
  description="Discover Japanese Jiu Jitsu in Wales, find your local club and explore regional and national events."
>
  <p class="lead">
    Discover Japanese Jiu Jitsu: a martial art that develops practical
    self-defence skills, fitness and confidence. Find a club in Wales and
    take your first step onto the mat.
  </p>

  <div class="grid">
    <section class="card">
      <h2>What is Jiu Jitsu?</h2>
      <p>
        Jiu Jitsu is a Japanese martial art that uses combinations of blocks,
        strikes, locks and throws. Training focuses on practical self-defence,
        with techniques taught through structured practice with a partner.
      </p>
      <p>
        You will learn defences against unarmed attackers and attackers armed
        with weapons such as knives, sticks and bottles, including situations
        involving multiple attackers.
      </p>
    </section>
  </div>

  <section class="section" id="clubs" aria-labelledby="clubs-heading">
    <div class="section-heading">
      <h2 id="clubs-heading">Find your club</h2>
      <p>Explore training times, locations and how to get started.</p>
    </div>
    <div class="card">
      <ul class="club-list">
        {clubs.map((club) => (
          <li>
            {club.href ? (
              <a class="button" href={club.href}>{club.name}</a>
            ) : (
              <span class="status">{club.name} — Details coming soon</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section card" aria-labelledby="events-heading">
    <h2 id="events-heading">Events across the Jitsu community</h2>
    <p>See regional and national events in our shared Google Calendar.</p>
    <a class="button" href="/events/">View events</a>
  </section>
</SiteLayout>
