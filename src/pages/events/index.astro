---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Jiu Jitsu Events in Wales | Jitsu Wales"
  heading="Jitsu Wales Events"
  description="See upcoming regional and national Jiu Jitsu events for the Jitsu Wales community in our shared calendar."
  heroImage="/events/image.webp"
  heroImageMobile="/events/image-mobile.webp"
>


  <p class="lead">Regional and national Jiu Jitsu events, with dates from our Google Calendar.</p>

  <!-- EMBEDS -->
  <div class="grid" style="margin-top: 24px; margin-bottom: 24px;">

    <div class="card">
      <h2>Regional and National Events</h2>
      <iframe title="Regional and national Jiu Jitsu events calendar" src="https://calendar.google.com/calendar/embed?mode=AGENDA&height=600&wkst=2&ctz=Europe%2FLondon&showPrint=0&title=Regional%20and%20National%20Events&hl=en_GB&showTz=0&showCalendars=0&showTabs=0&src=766442830e817b47c1289e94e244f37a15a7c47dc14ef3270029bfea733f134f%40group.calendar.google.com&color=%23cc003c&color=%238E24AA"></iframe>
    </div>

  </div>

  <!-- CONTACT / SOCIAL -->
  <p style="text-align: center;">
    Use the button below to open the Events Calendar directly if it does not appear in the box above
  </p>
  <div class="links">
    <a href="https://calendar.google.com/calendar/embed?src=766442830e817b47c1289e94e244f37a15a7c47dc14ef3270029bfea733f134f%40group.calendar.google.com&ctz=Europe%2FLondon">Open calendar directly</a>
  </div>


</SiteLayout>
